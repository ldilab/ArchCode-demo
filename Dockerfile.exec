# Dockerfile.exec (일부만 발췌)
FROM continuumio/miniconda3:24.1.2-0

SHELL ["/bin/bash", "-lc"]
WORKDIR /app

# 시스템 패키지 (+ docker CLI 추가)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates docker.io && \
    rm -rf /var/lib/apt/lists/*

# 이하 동일 ...

ENV CONDA_PKGS_DIRS=/opt/conda/pkgs_cache
RUN mkdir -p $CONDA_PKGS_DIRS && \
    conda install -n base -y conda-libmamba-solver && \
    conda config --set solver libmamba && \
    conda config --set channel_priority flexible

RUN for i in {1..3}; do \
      conda create -n ArchCode python=3.10 -y && break || \
      (echo "conda create failed ($i). Cleaning & retrying..." && conda clean --all -y && sleep 5); \
    done

COPY ./ArchCode/requirements.txt /app/requirements.txt
RUN conda run -n ArchCode pip install --no-cache-dir -r requirements.txt

COPY ./ArchCode /app
RUN conda run -n ArchCode pip install -e third_party/expand_langchain

EXPOSE 5097
WORKDIR /app/third_party/CodeExecContainer
CMD ["conda", "run", "--no-capture-output", "-n", "ArchCode", "sh", "./run.sh"]
